{
  "rules": {
    "config": {
      "inicializado": {
        ".read": true,
        ".write": "auth != null && !data.exists()"
      }
    },
    "usuarios": {
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('rol').val() === 'ADMIN'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && ((auth.uid === $uid && !data.exists() && !root.child('usuarios').exists()) || root.child('usuarios').child(auth.uid).child('rol').val() === 'ADMIN')"
      }
    },
    "eventos": {
      ".indexOn": ["fecha"],
      ".read": "auth != null && root.child('usuarios').child(auth.uid).child('rol').val() === 'ADMIN'",
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['fecha', 'usuario', 'texto'])"
      }
    }
  }
}
